                input[2] = channel.value([[id:'mt'], [file(params.subworkflow_fixtures + '/minimal_reference_mt.dict', checkIfExists: true)]])
                input[3] = channel.value([[id:'mt'], [file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta.fai', checkIfExists: true)]])
                input[4] = channel.value([[id:'mt'], [file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta', checkIfExists: true)]])
