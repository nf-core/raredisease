nextflow_workflow {

    name "Test Workflow ALIGN_MT"
    script "subworkflows/local/align_MT/main.nf"
    workflow "ALIGN_MT"

    tag "subworkflows"
    tag "align_mt"

    tag "bwa/mem"
    tag "bwamem2/mem"
    tag "sentieon/bwamem"
    tag "gatk4/mergebamalignment"
    tag "picard/addorreplacereadgroups"
    tag "picard/markduplicates"
    tag "samtools/sort"

    config "./nextflow.config"

    test("align mt - bwamem2") {

        setup {
            run("BWAMEM2_INDEX", alias: 'MT_MEM2') {
                script "modules/nf-core/bwamem2/index/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'mt'],
                        file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta', checkIfExists: true)
                    ])
                    """
                }
            }
        }
        when {
            params {
                outdir                       = "$outputDir"
            }
            workflow {
                """
                input[0] = [[:],[]]
                input[1] = MT_MEM2.out.index.collect()
                input[2] = channel.value([[id:'mt'], [file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.dict', checkIfExists: true)]])
                input[3] = channel.value([[id:'mt'], [file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta.fai', checkIfExists: true)]])
                input[4] = channel.value([[id:'mt'], [file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta', checkIfExists: true)]])
                input[5] = channel.of(
                    [
                        [ id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", 'lane':1, 'sex':2, 'phenotype':1, 'paternal':0, 'maternal':0, 'case_id':'amusingmarmoset'  ], // meta map
                        [ file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_2.fastq.gz', checkIfExists: true)]
                    ]
                )
                input[6] = channel.of(
                    [
                        [ id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", 'lane':1, 'sex':2, 'phenotype':1, 'paternal':0, 'maternal':0, 'case_id':'amusingmarmoset'  ], // meta map
                        [ file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtreverted.bam', checkIfExists: true)]
                    ]
                )
                input[7] = "bwamem2"
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

