                        [ file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_2.fastq.gz', checkIfExists: true)]
                    ]
