                input[6] = channel.of(
                    [
                        [ id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", 'lane':1, 'sex':2, 'phenotype':1, 'paternal':0, 'maternal':0, 'case_id':'amusingmarmoset'  ], // meta map
                        [ file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtreverted.bam', checkIfExists: true)]
