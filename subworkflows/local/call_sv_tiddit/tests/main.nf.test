nextflow_workflow {

    name "Test Workflow CALL_SV_TIDDIT"
    script "subworkflows/local/call_sv_tiddit/main.nf"
    workflow "CALL_SV_TIDDIT"

    tag "subworkflows"
    tag "call_sv_tiddit"

    tag "tiddit/sv"
    tag "svdb/merge"
    tag "tabix/bgziptabix"
    tag "bcftools/view"

    config "./nextflow.config"

    test("CALL_SV_TIDDIT - wgs, minimal dataset") {

        setup {
            run("BWA_INDEX") {
                script "modules/nf-core/bwa/index/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'genome'],
                        file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam', checkIfExists: true),
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam', checkIfExists: true),
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[1] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[2] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = BWA_INDEX.out.index.collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf -> file(vcf).name }
                ).match() }
            )
        }
    }
    test("CALL_SV_TIDDIT - wgs, stub") {

        options "-stub"

        setup {
            run("BWA_INDEX") {
                script "modules/nf-core/bwa/index/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'genome'],
                        file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam', checkIfExists: true),
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam', checkIfExists: true),
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[1] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[2] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = BWA_INDEX.out.index.collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
