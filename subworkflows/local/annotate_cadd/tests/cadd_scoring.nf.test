// Real (non-stub) end-to-end test for ANNOTATE_CADD's all-prescored scoring path.
//
// It is kept OUT of the routine nf-test run (listed in `ignore` in nf-test.config)
// because the CADD module's container, docker.io/clinicalgenomics/cadd-with-scripts,
// is ~20 GB. It runs instead from .github/workflows/nf-test-cadd.yml, only on PRs that
// touch this subworkflow or a module it uses (and on demand), via:
//   nf-test test -c tests/nf-test-cadd.config \
//       subworkflows/local/annotate_cadd/tests/cadd_scoring.nf.test --profile=+docker
//
// The fixtures below (cadd_prescored.tar.gz, cadd_annotations.tar.gz,
// cadd_test_variants.vcf.gz) are generated by scripts/build_cadd_prescored_fixture.py
// on the nf-core/test-datasets `raredisease` branch. Re-run that script on the next
// CADD version bump (see its header for the command and follow-up steps).

nextflow_workflow {

    name "Test Workflow ANNOTATE_CADD (scoring)"
    script "subworkflows/local/annotate_cadd/main.nf"
    workflow "ANNOTATE_CADD"

    tag "subworkflows"
    tag "annotate_cadd"
    tag "cadd_scoring"

    tag "bcftools/annotate"
    tag "bcftools/view"
    tag "cadd"
    tag "gawk"
    tag "tabix/tabix"
    tag "untar"

    test("ANNOTATE_CADD - GRCh38, minimal dataset") {

        config "./nextflow_real.config"

        setup {
            run("UNTAR", alias: 'UNTAR_CADD_PRESCORED') {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [id:'cadd_prescored'],
                        file(params.resources_remapped + '/cadd/cadd_prescored.tar.gz', checkIfExists: true)
                    ]
                    """
                }
            }
            run("UNTAR", alias: 'UNTAR_CADD_ANNOTATIONS') {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [id:'cadd_annotations'],
                        file(params.resources_remapped + '/cadd/cadd_annotations.tar.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                genome = "GRCh38"
            }
            workflow {
                """
                input[0] = UNTAR_CADD_ANNOTATIONS.out.untar.collect()
                input[1] = UNTAR_CADD_PRESCORED.out.untar.collect()
                input[2] = channel.of([[id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)]).collect()
                input[3] = channel.of(file('https://raw.githubusercontent.com/nf-core/raredisease/refs/heads/master/assets/cadd_to_vcf_header_-1.0-.txt', checkIfExists: true)).collect()
                input[4] = channel.of([
                    [id:'test', single_end: false],
                    file(params.subworkflow_fixtures + '/cadd_test_variants.vcf.gz', checkIfExists: true),
                    file(params.subworkflow_fixtures + '/cadd_test_variants.vcf.gz.tbi', checkIfExists: true)
                ])
                input[5] = 'GRCh38'
                """
            }
        }

        then {
            def annotatedVcf = workflow.out.vcf[0][1].toString()
            def caddAnnotations = path(annotatedVcf).linesGzip
                .findAll { variantLine -> !variantLine.startsWith('#') }
                .collect { variantLine ->
                    def (chrom, pos, id, ref, alt, qual, filter, info) = variantLine.split('\t')
                    [chrom, pos, ref, alt, info].join('\t')
                }
            assertAll(
                { assert workflow.success },
                { assert snapshot(path(annotatedVcf).vcf.variantsMD5, caddAnnotations).match() }
            )
        }
    }

}
