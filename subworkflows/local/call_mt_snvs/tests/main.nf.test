nextflow_workflow {

    name "Test Workflow CALL_MT_SNVS"
    script "subworkflows/local/call_mt_snvs/main.nf"
    workflow "CALL_MT_SNVS"

    tag "subworkflows"
    tag "call_mt_snvs"
    tag "call_snv_MT"
    tag "postprocess_MT_calls"
    tag "get_chrom_sizes"

    setup {
        run("GET_CHROM_SIZES") {
            script "modules/local/get_chrom_sizes/main.nf"
            process {
                """
                input[0] = channel.of([
                    [id:'genome'],
                    file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("CALL_MT_SNVS - wgs, minimal dataset") {

        when {
            workflow {
                """
                input[0] = channel.of([id:'amusingmarmoset'])
                input[1] = channel.of(file('https://raw.githubusercontent.com/nf-core/raredisease/refs/heads/master/assets/foundin.hdr', checkIfExists: true)).collect()
                input[2] = GET_CHROM_SIZES.out.sizes.collect()
                input[3] = channel.of([
                    [id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_aligned.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_aligned.bam.bai', checkIfExists: true)
                ])
                input[4] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.dict', checkIfExists: true)]).collect()
                input[5] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta.fai', checkIfExists: true)]).collect()
                input[6] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta', checkIfExists: true)]).collect()
                input[7] = channel.of(file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.intervals', checkIfExists: true)).collect()
                input[8] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.back_chain', checkIfExists: true)]).collect()
                input[9] = channel.of([
                    [id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtshift_aligned.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtshift_aligned.bam.bai', checkIfExists: true)
                ])
                input[10] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.dict', checkIfExists: true)]).collect()
                input[11] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.fasta.fai', checkIfExists: true)]).collect()
                input[12] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.fasta', checkIfExists: true)]).collect()
                input[13] = channel.of(file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.intervals', checkIfExists: true)).collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf -> file(vcf).name },
                    workflow.out.tbi.collect { meta, tbi -> file(tbi).name }
                ).match() }
            )
        }
    }

    test("CALL_MT_SNVS - wgs, stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([id:'amusingmarmoset'])
                input[1] = channel.of(file('https://raw.githubusercontent.com/nf-core/raredisease/refs/heads/master/assets/foundin.hdr', checkIfExists: true)).collect()
                input[2] = GET_CHROM_SIZES.out.sizes.collect()
                input[3] = channel.of([
                    [id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_aligned.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mt_aligned.bam.bai', checkIfExists: true)
                ])
                input[4] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.dict', checkIfExists: true)]).collect()
                input[5] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta.fai', checkIfExists: true)]).collect()
                input[6] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.fasta', checkIfExists: true)]).collect()
                input[7] = channel.of(file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mt.intervals', checkIfExists: true)).collect()
                input[8] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.back_chain', checkIfExists: true)]).collect()
                input[9] = channel.of([
                    [id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtshift_aligned.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/ACC13778A2_mtshift_aligned.bam.bai', checkIfExists: true)
                ])
                input[10] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.dict', checkIfExists: true)]).collect()
                input[11] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.fasta.fai', checkIfExists: true)]).collect()
                input[12] = channel.of([[id:'mt'], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.fasta', checkIfExists: true)]).collect()
                input[13] = channel.of(file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/minimal_reference_mtshift.intervals', checkIfExists: true)).collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out
                ).match() }
            )
        }
    }
}
