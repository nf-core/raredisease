nextflow_function {

    name "Test Functions"
    script "../main.nf"
    tag "subworkflows"
    tag "utils_nfcore_raredisease_pipeline"

    test("validateNoMixedCaseInput - all align rows, no error") {

        function "validateNoMixedCaseInput"

        when {
            function {
                """
                input[0] = [
                    [case_id: 'fam1', data_type: 'fastq_gz'],
                    [case_id: 'fam1', data_type: 'bam']
                ]
                """
            }
        }

        then {
            assert function.success
        }
    }

    test("validateNoMixedCaseInput - all vcf rows, no error") {

        function "validateNoMixedCaseInput"

        when {
            function {
                """
                input[0] = [
                    [case_id: 'fam1', data_type: 'snv_vcf'],
                    [case_id: 'fam1', data_type: 'sv_vcf'],
                    [case_id: 'fam1', data_type: 'mt_vcf']
                ]
                """
            }
        }

        then {
            assert function.success
        }
    }

    test("validateNoMixedCaseInput - mixed align and vcf rows, errors") {

        function "validateNoMixedCaseInput"

        when {
            function {
                """
                input[0] = [
                    [case_id: 'fam1', data_type: 'fastq_gz'],
                    [case_id: 'fam1', data_type: 'snv_vcf']
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("mixes precalled VCF input") } }
            )
        }
    }

    test("extractPrecalledVcfs - normal grouping") {

        function "extractPrecalledVcfs"

        when {
            function {
                """
                input[0] = [
                    [[data_type: 'snv_vcf'], ['snv.vcf.gz', 'snv.vcf.gz.tbi']],
                    [[data_type: 'sv_vcf'],  ['sv.vcf.gz', 'sv.vcf.gz.tbi']]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.snv == ['snv.vcf.gz', 'snv.vcf.gz.tbi'] },
                { assert function.result.sv  == ['sv.vcf.gz', 'sv.vcf.gz.tbi'] },
                { assert function.result.mt  == null },
                { assert function.result.me  == null },
                { assert function.result.repeat == null }
            )
        }
    }

    test("extractPrecalledVcfs - includes me") {

        function "extractPrecalledVcfs"

        when {
            function {
                """
                input[0] = [
                    [[data_type: 'me_vcf'], ['me.vcf.gz', 'me.vcf.gz.tbi']]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.me == ['me.vcf.gz', 'me.vcf.gz.tbi'] }
            )
        }
    }

    test("extractPrecalledVcfs - includes repeat") {

        function "extractPrecalledVcfs"

        when {
            function {
                """
                input[0] = [
                    [[data_type: 'repeat_vcf'], ['repeat.vcf.gz', 'repeat.vcf.gz.tbi']]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.repeat == ['repeat.vcf.gz', 'repeat.vcf.gz.tbi'] }
            )
        }
    }

    test("extractPrecalledVcfs - conflicting VCFs for same type, errors") {

        function "extractPrecalledVcfs"

        when {
            function {
                """
                input[0] = [
                    [[data_type: 'snv_vcf'], ['snv_a.vcf.gz', 'snv_a.vcf.gz.tbi']],
                    [[data_type: 'snv_vcf'], ['snv_b.vcf.gz', 'snv_b.vcf.gz.tbi']]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("Conflicting precalled") } }
            )
        }
    }

    test("hasPrecalledSnvVcf/hasPrecalledSvVcf/hasPrecalledMtVcf - all types present") {

        function "hasPrecalledSnvVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_all_vcf.csv"
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }

    test("hasPrecalledMeVcf - present") {

        function "hasPrecalledMeVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_all_vcf_full.csv"
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }

    test("hasPrecalledMeVcf - missing from partial samplesheet") {

        function "hasPrecalledMeVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_me.csv"
            }
        }

        then {
            assert function.success
            assert function.result == false
        }
    }

    test("hasPrecalledRepeatVcf - present") {

        function "hasPrecalledRepeatVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_all_vcf_full.csv"
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }

    test("hasPrecalledRepeatVcf - missing from partial samplesheet") {

        function "hasPrecalledRepeatVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_repeat.csv"
            }
        }

        then {
            assert function.success
            assert function.result == false
        }
    }

    test("hasPrecalledSnvVcf - no vcf rows at all") {

        function "hasPrecalledSnvVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_no_vcf.csv"
            }
        }

        then {
            assert function.success
            assert function.result == false
        }
    }

    test("hasPrecalledMtVcf - missing from partial samplesheet") {

        function "hasPrecalledMtVcf"

        when {
            params {
                input = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf.csv"
            }
        }

        then {
            assert function.success
            assert function.result == false
        }
    }

    test("validatePrecalledVcfCoverage - fully covered, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input         = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_all_vcf_full.csv"
                analysis_type = 'wgs'
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - no precalled input at all, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input         = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_no_vcf.csv"
                analysis_type = 'wgs'
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - mt uncovered and not skipped on wgs, errors") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = ''
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("mt") } }
            )
        }
    }

    test("validatePrecalledVcfCoverage - mt uncovered but explicitly skipped, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = 'mt_snv_calling,me_calling,repeat_calling'
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - mt not applicable on wes, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf.csv"
                analysis_type     = 'wes'
                run_mt_for_wes    = false
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - me uncovered and not skipped on wgs, errors") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_me.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = ''
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("me") } }
            )
        }
    }

    test("validatePrecalledVcfCoverage - me uncovered but explicitly skipped, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_me.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = 'me_calling,repeat_calling'
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - me not applicable on wes, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_me.csv"
                analysis_type     = 'wes'
                run_mt_for_wes    = false
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - repeat uncovered and not skipped on wgs, errors") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_repeat.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = ''
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { it.contains("repeat") } }
            )
        }
    }

    test("validatePrecalledVcfCoverage - repeat uncovered but explicitly skipped, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_repeat.csv"
                analysis_type     = 'wgs'
                skip_subworkflows = 'repeat_calling'
            }
        }

        then {
            assert function.success
        }
    }

    test("validatePrecalledVcfCoverage - repeat not applicable on wes, no error") {

        function "validatePrecalledVcfCoverage"

        when {
            params {
                input             = "${projectDir}/subworkflows/local/utils_nfcore_raredisease_pipeline/tests/samplesheet_partial_vcf_no_repeat.csv"
                analysis_type     = 'wes'
                run_mt_for_wes    = false
            }
        }

        then {
            assert function.success
        }
    }

    test("resolveAnalysisSex - samplesheet mode always keeps the declared value") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '1'
                input[1] = 'female'
                input[2] = 'samplesheet'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '1'
        }
    }

    test("resolveAnalysisSex - auto fills a missing sex from the estimate") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '0'
                input[1] = 'male'
                input[2] = 'auto'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '1'
        }
    }

    test("resolveAnalysisSex - auto keeps a declared sex even if the estimate differs") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '2'
                input[1] = 'male'
                input[2] = 'auto'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '2'
        }
    }

    test("resolveAnalysisSex - auto keeps 'other' when the estimate is unusable") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = 'other'
                input[1] = 'unknown'
                input[2] = 'auto'
                """
            }
        }

        then {
            assert function.success
            assert function.result == 'other'
        }
    }

    test("resolveAnalysisSex - estimated overrides a declared sex") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '1'
                input[1] = 'female'
                input[2] = 'estimated'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '2'
        }
    }

    test("resolveAnalysisSex - estimated falls back to the declared value when the estimate is unknown") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '2'
                input[1] = 'unknown'
                input[2] = 'estimated'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '2'
        }
    }

    test("resolveAnalysisSex - handles an integer samplesheet sex and a mixed-case estimate") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = 0
                input[1] = 'MALE'
                input[2] = 'auto'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '1'
        }
    }

    test("resolveAnalysisSex - auto with a missing sex and no estimate stays unknown") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '0'
                input[1] = null
                input[2] = 'auto'
                """
            }
        }

        then {
            assert function.success
            assert function.result == '0'
        }
    }

    test("resolveAnalysisSex - unknown mode fails loudly") {

        function "resolveAnalysisSex"

        when {
            function {
                """
                input[0] = '1'
                input[1] = 'female'
                input[2] = 'bogus'
                """
            }
        }

        then {
            assert function.failed
            assert function.stdout.any { it.contains("unknown sex_source mode 'bogus'") }
        }
    }

    test("validateSexSource - default samplesheet source, ngsbits skipped, no error") {

        function "validateSexSource"

        when {
            params {
                sex_source = 'samplesheet'
                skip_tools = 'ngsbits'
            }
        }

        then {
            assert function.success
        }
    }

    test("validateSexSource - auto source with ngsbits available, no error") {

        function "validateSexSource"

        when {
            params {
                sex_source = 'auto'
                skip_tools = 'fastp'
            }
        }

        then {
            assert function.success
        }
    }

    test("validateSexSource - auto source with ngsbits skipped, errors") {

        function "validateSexSource"

        when {
            params {
                sex_source = 'auto'
                skip_tools = 'fastp,ngsbits'
            }
        }

        then {
            assert function.failed
            assert function.stdout.any { it.contains("needs the ngs-bits SampleGender step") }
        }
    }

    test("validateSexSource - estimated source with ngsbits skipped, errors") {

        function "validateSexSource"

        when {
            params {
                sex_source = 'estimated'
                skip_tools = 'ngsbits'
            }
        }

        then {
            assert function.failed
            assert function.stdout.any { it.contains("--sex_source 'estimated'") }
        }
    }
}
