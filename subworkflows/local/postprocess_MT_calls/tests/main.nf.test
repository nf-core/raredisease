nextflow_workflow {

    name "Test Workflow POSTPROCESS_MT_CALLS"
    script "subworkflows/local/postprocess_MT_calls/main.nf"
    workflow "POSTPROCESS_MT_CALLS"

    tag "subworkflows"
    tag "postprocess_MT_calls"

    tag "gatk4/mergevcfs"
    tag "gatk4/variantfiltration"
    tag "bcftools/norm"
    tag "tabix/tabix"
    tag "bcftools/merge"
    tag "picard/liftovervcf"
    tag "bcftools/annotate"
    tag "local/add_varcallername_to_bed"
    tag "get_chrom_sizes"

    config "./nextflow.config"

    setup {
        run("GET_CHROM_SIZES") {
            script "modules/local/get_chrom_sizes/main.nf"
            process {
                """
                input[0] = channel.of([
                    [id:'genome'],
                    file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("POSTPROCESS_MT_CALLS - wgs, minimal dataset") {

        when {
            workflow {
                """
                input[0] = channel.of([id:'amusingmarmoset'])
                input[1] = channel.of(file('https://raw.githubusercontent.com/nf-core/raredisease/refs/heads/master/assets/foundin.hdr', checkIfExists: true)).collect()
                input[2] = GET_CHROM_SIZES.out.sizes.collect()
                input[3] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.dict', checkIfExists: true)]).collect()
                input[4] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta.fai', checkIfExists: true)]).collect()
                input[5] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta', checkIfExists: true)]).collect()
                input[6] = channel.of([
                    [id:'ACC13778A2', case_id:'amusingmarmoset'],
                    file(params.subworkflow_fixtures + '/ACC13778A2_mutect2_mt.vcf.gz', checkIfExists: true)
                ])
                input[7] = channel.of([[id:'genome'], file(params.subworkflow_fixtures + '/minimal_reference_mtshift.back_chain', checkIfExists: true)]).collect()
                input[8] = channel.of([
                    [id:'ACC13778A2', case_id:'amusingmarmoset'],
                    file(params.subworkflow_fixtures + '/ACC13778A2_mutect2_mtshift.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    workflow.out.vcf.collect { meta, vcf -> file(vcf).name },
                    workflow.out.tbi.collect { meta, tbi -> file(tbi).name }
                ).match() }
            )
        }
    }

    test("POSTPROCESS_MT_CALLS - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([id:'amusingmarmoset'])
                input[1] = channel.of(file('https://raw.githubusercontent.com/nf-core/raredisease/refs/heads/master/assets/foundin.hdr', checkIfExists: true)).collect()
                input[2] = GET_CHROM_SIZES.out.sizes.collect()
                input[3] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.dict', checkIfExists: true)]).collect()
                input[4] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta.fai', checkIfExists: true)]).collect()
                input[5] = channel.of([[id:'mt'], file(params.subworkflow_fixtures + '/minimal_reference_mt.fasta', checkIfExists: true)]).collect()
                input[6] = channel.of([
                    [id:'ACC13778A2', case_id:'amusingmarmoset'],
                    file(params.subworkflow_fixtures + '/ACC13778A2_mutect2_mt.vcf.gz', checkIfExists: true)
                ])
                input[7] = channel.of([[id:'genome'], file(params.subworkflow_fixtures + '/minimal_reference_mtshift.back_chain', checkIfExists: true)]).collect()
                input[8] = channel.of([
                    [id:'ACC13778A2', case_id:'amusingmarmoset'],
                    file(params.subworkflow_fixtures + '/ACC13778A2_mutect2_mtshift.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
