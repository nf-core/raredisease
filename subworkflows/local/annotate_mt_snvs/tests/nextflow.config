process {

    withName: 'VCFANNO_MT' {
        ext.prefix = { "${meta.prefix}" }
    }

    withName: 'ZIP_TABIX_VCFANNO_MT' {
        ext.prefix = { "${meta.prefix}" }
    }

    withName: 'ENSEMBLVEP_MT' {
        // --dir_plugins/--merged/--cache/--offline assume a cache-bundled Plugins/
        // dir and an Ensembl+RefSeq merged cache; neither exists in --gtf mode
        // (no cache staged at all), so all are conditional on whether a gtf input
        // was supplied to this specific test -- matches conf/modules/annotate_mt_snvs.config.
        ext.args = {
            def dir_plugins = gtf ? '.' : 'vep_cache/Plugins'
            def cache_flags = gtf ? '' : '--cache --offline --merged'
            [
                "--dir_plugins ${dir_plugins}",
                '--plugin LoFtool,LoFtool_scores.txt',
                '--plugin pLI,pLI_values.txt',
                '--plugin SpliceAI,snv=spliceai_snv.vcf.gz,indel=spliceai_indel.vcf.gz',
                '--distance 0',
                '--buffer_size 20000',
                '--format vcf --max_sv_size 248956422',
                "--appris --biotype ${cache_flags} --canonical --ccds --compress_output bgzip",
                '--domains --exclude_predicted --force_overwrite',
                '--hgvs --humdiv --no_progress --numbers',
                '--polyphen p --protein --regulatory --sift p --symbol --tsl --vcf',
                '--uniprot'
            ].join(' ')
        }
        ext.prefix = { "${meta.prefix}" }
    }

    withName: 'BCFTOOLS_PLUGINSETGT' {
        ext.prefix = { "${meta.prefix}_mt_modifiedgt" }
        ext.args   = "--output-type z --write-index=tbi"
        ext.args2  = { "-i 'FMT/AF>=${params.homoplasmy_af_threshold} && FMT/DP>=100'" }
    }
}
