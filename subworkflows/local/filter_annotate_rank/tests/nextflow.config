process {
    withName: 'FILTER_ANNOTATE_RANK:GENERATE_CLINICAL_SET:FILTERVEP' {
        ext.prefix = { "${meta.id}_${meta.set}" }
        ext.args   = { "--filter \"HGNC_ID in ${feature_file}\"" }
    }

    withName: 'FILTER_ANNOTATE_RANK:GENERATE_CLINICAL_SET:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}_${meta.set}" }
    }

    withName: 'FILTER_ANNOTATE_RANK:ANNOTATE_CSQ_PLI:CUSTOM_ADDMOSTSEVERECONSEQUENCE' {
        ext.prefix = { "${meta.id}_csq_${meta.set}" }
    }

    withName: 'FILTER_ANNOTATE_RANK:ANNOTATE_CSQ_PLI:CUSTOM_ADDMOSTSEVEREPLI' {
        ext.prefix = { "${meta.id}_csq_pli_${meta.set}" }
    }

    withName: 'FILTER_ANNOTATE_RANK:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_genmod_annotate_${meta.set}" }
        ext.args = { [
            '--annotate_regions',
            params.genome.equals('GRCh37') ? '--genome-build 37' : '--genome-build 38',
            '--temp_dir ./'
            ].join(' ') }
    }

    withName: 'FILTER_ANNOTATE_RANK:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_genmod_models_${meta.set}" }
        ext.args = "--whole_gene --temp_dir ./"
    }

    withName: 'FILTER_ANNOTATE_RANK:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_genmod_score_${meta.set}" }
        ext.args = "--rank_results"
    }

    withName: 'FILTER_ANNOTATE_RANK:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_genmod_compound_${meta.set}" }
        ext.args = "--temp_dir ./"
    }

    withName: 'FILTER_ANNOTATE_RANK:RANK_VARIANTS:TABIX_BGZIPTABIX' {
        ext.args2 = '-p vcf'
        ext.prefix = { "${meta.id}_ranked_${meta.set}" }
    }
}
