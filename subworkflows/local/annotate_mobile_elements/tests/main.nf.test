nextflow_workflow {

    name "Test Workflow ANNOTATE_MOBILE_ELEMENTS"
    script "subworkflows/local/annotate_mobile_elements/main.nf"
    workflow "ANNOTATE_MOBILE_ELEMENTS"

    tag "subworkflows"
    tag "annotate_mobile_elements"

    tag "bcftools/view"
    tag "ensemblvep/vep"
    tag "picard/sortvcf"
    tag "svdb/query"

    config "./nextflow.config"

    test("ANNOTATE_MOBILE_ELEMENTS - wgs, minimal dataset") {

        when {
            params {
                bcftools_args = "--apply-filters .,PASS --output-type z"
            }
            workflow {
                """
                input[0] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.dict', checkIfExists: true)]).collect()
                input[1] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)]).collect()
                input[2] = channel.of([
                    file(params.pipelines_testdata_base_path + 'resources_remapped/svdb/grch38_gnomad.v4.1.sv.sites.no_cnv.remapped.vcf.gz', checkIfExists: true),
                    'AF',
                    'AC',
                    'gnomad_svAF',
                    'gnomad_svAC'
                ])
                input[3] = channel.of([[id:'amusingmarmoset', "single_end": false], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/amusingmarmoset_mobile_elements.vcf.gz', checkIfExists: true)])
                input[4] = channel.value([[:], []])
                input[5] = 'GRCh38'
                input[6] = 116
                input[7] = [
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/LoFtool.pm', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/pLI.pm', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/SpliceAI.pm', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/plugin_config.txt', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/LoFtool_scores.txt', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/pLI_values.txt', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/spliceai_snv.vcf.gz', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/spliceai_snv.vcf.gz.tbi', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/spliceai_indel.vcf.gz', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/spliceai_indel.vcf.gz.tbi', checkIfExists: true)
                            ]
                input[8] = channel.of(
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/minimal_reference.sorted.gtf.gz', checkIfExists: true),
                                file(params.pipelines_testdata_base_path + 'resources_remapped/vep_gtf/minimal_reference.sorted.gtf.gz.tbi', checkIfExists: true)
                            ).collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    "${file(workflow.out.vcf_ann[0][1]).name}",
                    path(workflow.out.vcf_ann[0][1]).vcf.summary
                ).match() }
            )
        }
    }

    test("ANNOTATE_MOBILE_ELEMENTS - wgs, stub") {

        options "-stub"

        when {
            params {
                bcftools_args = "--apply-filters .,PASS --output-type z"
            }
            workflow {
                """
                input[0] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.dict', checkIfExists: true)]).collect()
                input[1] = channel.of([[id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)]).collect()
                input[2] = channel.of([
                    file(params.pipelines_testdata_base_path + 'resources_remapped/svdb/grch38_gnomad.v4.1.sv.sites.no_cnv.remapped.vcf.gz', checkIfExists: true),
                    'AF',
                    'AC',
                    'gnomad_svAF',
                    'gnomad_svAC'
                ])
                input[3] = channel.of([[id:'amusingmarmoset', "single_end": false], file(params.pipelines_testdata_base_path + 'subworkflow_fixtures/amusingmarmoset_mobile_elements.vcf.gz', checkIfExists: true)])
                input[4] = channel.value([[:], []])
                input[5] = 'GRCh38'
                input[6] = 116
                input[7] = channel.value([])
                input[8] = channel.value([[],[]])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
