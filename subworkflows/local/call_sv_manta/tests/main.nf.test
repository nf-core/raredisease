nextflow_workflow {

    name "Test Workflow CALL_SV_MANTA"
    script "subworkflows/local/call_sv_manta/main.nf"
    workflow "CALL_SV_MANTA"

    tag "subworkflows"
    tag "call_sv_manta"

    tag "manta/germline"
    tag "bcftools/view"

    config "./nextflow.config"

    test("CALL_SV_MANTA - minimal dataset") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [${TestData.sample('ACC13778A1')},
                     file(params.alignment + '/ACC13778A1_sorted_md.bam', checkIfExists: true)],
                    [${TestData.sample('ACC13778A2')},
                     file(params.alignment + '/ACC13778A2_sorted_md.bam', checkIfExists: true)],
                    [${TestData.sample('ACC13778A3')},
                     file(params.alignment + '/ACC13778A3_sorted_md.bam', checkIfExists: true)]
                )
                input[1] = channel.of(
                    [${TestData.sample('ACC13778A1')},
                     file(params.alignment + '/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)],
                    [${TestData.sample('ACC13778A2')},
                     file(params.alignment + '/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [${TestData.sample('ACC13778A3')},
                     file(params.alignment + '/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[2] = channel.of([id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = channel.of([id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                input[5] = channel.value([[], []])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path(workflow.out.diploid_sv_vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.filtered_diploid_sv_vcf[0][1]).vcf.variantsMD5
                ).match() }
            )
        }
    }
    test("CALL_SV_MANTA - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [${TestData.sample('ACC13778A1')},
                     file(params.alignment + '/ACC13778A1_sorted_md.bam', checkIfExists: true)],
                    [${TestData.sample('ACC13778A2')},
                     file(params.alignment + '/ACC13778A2_sorted_md.bam', checkIfExists: true)],
                    [${TestData.sample('ACC13778A3')},
                     file(params.alignment + '/ACC13778A3_sorted_md.bam', checkIfExists: true)]
                )
                input[1] = channel.of(
                    [${TestData.sample('ACC13778A1')},
                     file(params.alignment + '/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)],
                    [${TestData.sample('ACC13778A2')},
                     file(params.alignment + '/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [${TestData.sample('ACC13778A3')},
                     file(params.alignment + '/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[2] = channel.of([id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = channel.of([id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                input[5] = channel.value([[], []])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
