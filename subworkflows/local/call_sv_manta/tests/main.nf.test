nextflow_workflow {

    name "Test Workflow CALL_SV_MANTA"
    script "subworkflows/local/call_sv_manta/main.nf"
    workflow "CALL_SV_MANTA"

    tag "subworkflows"
    tag "call_sv_manta"

    tag "manta/germline"
    tag "bcftools/view"

    config "./nextflow.config"

    test("CALL_SV_MANTA - minimal dataset") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [[id:'ACC13778A1', sample:'ACC13778A1', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A1\\\\tPL:illumina\\\\tSM:ACC13778A1'", lane:1, sex:1, phenotype:2, paternal:'ACC13778A3', maternal:'ACC13778A2', case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A1_sorted_md.bam', checkIfExists: true)],
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam', checkIfExists: true)]
                )
                input[1] = channel.of(
                    [[id:'ACC13778A1', sample:'ACC13778A1', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A1\\\\tPL:illumina\\\\tSM:ACC13778A1'", lane:1, sex:1, phenotype:2, paternal:'ACC13778A3', maternal:'ACC13778A2', case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[2] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                input[5] = channel.value([[], []])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path(workflow.out.diploid_sv_vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.filtered_diploid_sv_vcf[0][1]).vcf.variantsMD5
                ).match() }
            )
        }
    }
    test("CALL_SV_MANTA - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [[id:'ACC13778A1', sample:'ACC13778A1', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A1\\\\tPL:illumina\\\\tSM:ACC13778A1'", lane:1, sex:1, phenotype:2, paternal:'ACC13778A3', maternal:'ACC13778A2', case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A1_sorted_md.bam', checkIfExists: true)],
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam', checkIfExists: true)]
                )
                input[1] = channel.of(
                    [[id:'ACC13778A1', sample:'ACC13778A1', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A1\\\\tPL:illumina\\\\tSM:ACC13778A1'", lane:1, sex:1, phenotype:2, paternal:'ACC13778A3', maternal:'ACC13778A2', case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A2', sample:'ACC13778A2', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A2\\\\tPL:illumina\\\\tSM:ACC13778A2'", lane:1, sex:2, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)],
                    [[id:'ACC13778A3', sample:'ACC13778A3', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:ACC13778A3\\\\tPL:illumina\\\\tSM:ACC13778A3'", lane:1, sex:1, phenotype:1, paternal:0, maternal:0, case_id:'amusingmarmoset'],
                     file(params.pipelines_testdata_base_path + 'alignment/ACC13778A3_sorted_md.bam.bai', checkIfExists: true)]
                )
                input[2] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta', checkIfExists: true)).collect()
                input[3] = channel.of([id:'genome'], file(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai', checkIfExists: true)).collect()
                input[4] = channel.of([id:'amusingmarmoset'])
                input[5] = channel.value([[], []])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
