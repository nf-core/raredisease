                    ${TestData.sample('ACC13778A2')},
                    [
                        file(params.subworkflow_fixtures + '/ACC13778A2_mt_1.fastq.gz', checkIfExists: true),
                        file(params.subworkflow_fixtures + '/ACC13778A2_mt_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[10] = channel.value(10000000)
                input[11] = channel.value(['manta', 'tiddit', 'cnvnator'])
                input[12] = channel.of([15, 2, 2, 30000, 30, 0.00001, 5, 1000, 80, 10000, 5, 15])
                input[13] = false
                input[14] = 16081
                input[15] = 407
                input[16] = 5730
                input[17] = 5763
                input[18] = 16569
                input[19] = 'chrM'
                input[20] = 15
                input[21] = 0.01
