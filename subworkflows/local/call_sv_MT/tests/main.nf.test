                input[1]  = channel.of([id:'amusingmarmoset'])
                input[2]  = GET_CHROM_SIZES.out.sizes.collect()
                input[3]  = channel.of([[id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)]).collect()
                input[4]  = channel.of([[id:'genome'], file(params.reference_sliced + '/minimal_reference.fasta', checkIfExists: true)]).collect()
                input[5]  = HISAT2_BUILD.out.index.collect()
