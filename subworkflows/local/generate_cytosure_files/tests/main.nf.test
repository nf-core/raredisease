nextflow_workflow {

    name "Test Workflow GENERATE_CYTOSURE_FILES"
    script "subworkflows/local/generate_cytosure_files/main.nf"
    workflow "GENERATE_CYTOSURE_FILES"

    tag "subworkflows"
    tag "generate_cytosure_files"

    tag "bcftools/view"
    tag "bcftools/reheader"
    tag "tiddit/cov"
    tag "vcf2cytosure"

    config "./nextflow.config"

    test("GENERATE_CYTOSURE_FILES - minimal dataset") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    ${TestData.sample('ACC13778A1')},
                    file(params.alignment + '/ACC13778A1_sorted_md.bam', checkIfExists: true),
                    file(params.alignment + '/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.value([])
                input[2] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.cgh.collect { meta, cgh -> [meta, file(cgh)] }
                ).match() }
            )
        }
    }

    test("GENERATE_CYTOSURE_FILES - vcf2cytosure uses meta.analysis_sex") {

        // ACC13778A2 is female (sex: 2); analysis_sex '1' must make vcf2cytosure
        // emit a male CGH (--sex male), i.e. male="true" in the sample element.
        when {
            workflow {
                """
                input[0] = channel.of([
                    ${TestData.sample('ACC13778A2', "analysis_sex:'1'")},
                    file(params.alignment + '/ACC13778A2_sorted_md.bam', checkIfExists: true),
                    file(params.alignment + '/ACC13778A2_sorted_md.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.value([])
                input[2] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.cgh[0][1]).readLines().any { cgh_line ->
                    cgh_line.contains('<sample sampleId="ACC13778A2" male="true">')
                } }
            )
        }
    }

    test("GENERATE_CYTOSURE_FILES - no customer_id, stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    ${TestData.sample('ACC13778A1')},
                    file(params.alignment + '/ACC13778A1_sorted_md.bam', checkIfExists: true),
                    file(params.alignment + '/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.value([])
                input[2] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("GENERATE_CYTOSURE_FILES - with customer_id, stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    ${TestData.sample('ACC13778A1', "customer_id:'CUST_001'")},
                    file(params.alignment + '/ACC13778A1_sorted_md.bam', checkIfExists: true),
                    file(params.alignment + '/ACC13778A1_sorted_md.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.value([])
                input[2] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id:'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
