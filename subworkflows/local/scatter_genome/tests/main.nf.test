nextflow_workflow {

    name "Test Workflow SCATTER_GENOME"
    script "subworkflows/local/scatter_genome/main.nf"
    workflow "SCATTER_GENOME"

    tag "subworkflows"
    tag "scatter_genome"

    tag "gawk"
    tag "gatk4_splitintervals"

    config "./nextflow.config"

    test("Should run without failures, minimal dataset") {

        when {
            params {
                scatter_count      = 8
            }
            workflow {
                """
                input[0] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.dict').map {it -> [[id:'genome'], it]}.collect()
                input[1] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai').map {it -> [[id:'genome'], it]}.collect()
                input[2] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta').map {it -> [[id:'genome'], it]}.collect()
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run without failures, stub") {

        options "-stub"

        when {
            params {
                scatter_count      = 8
            }
            workflow {
                """
                input[0] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.dict').map {it -> [[id:'genome'], it]}.collect()
                input[1] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta.fai').map {it -> [[id:'genome'], it]}.collect()
                input[2] = channel.of(params.pipelines_testdata_base_path + 'reference_sliced/minimal_reference.fasta').map {it -> [[id:'genome'], it]}.collect()
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
