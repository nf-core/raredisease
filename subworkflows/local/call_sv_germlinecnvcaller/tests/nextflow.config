
process {

    withName: "GATK4_COLLECTREADCOUNTS" {
        ext.args = "--format TSV --interval-merging-rule OVERLAPPING_ONLY"
    }

    withName: "GATK4_DETERMINEGERMLINECONTIGPLOIDY" {
        ext.prefix = { "${meta.id}_ploidy" }
    }

    withName: "GATK4_GERMLINECNVCALLER" {
        ext.args = "--run-mode CASE"
    }

    withName: 'BCFTOOLS_VIEW' {
        ext.args   = { '--output-type z --exclude "N_ALT = 0" --apply-filters .,PASS' }
        ext.prefix = { "${meta.id}_gatkcnv_segments_refiltered" }
    }

    withName: 'SVDB_MERGE_GCNVCALLER' {
        ext.prefix = { "${meta.id}_gcnvcaller" }
    }
}
