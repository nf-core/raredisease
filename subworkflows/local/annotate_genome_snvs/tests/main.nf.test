                            ]
                input[13] = channel.of(file(params.pipelines_testdata_base_path + 'resources_remapped/vcfanno/grch38_vcfanno_config_remapped.toml', checkIfExists: true)).collect()
                input[14] = channel.value([[:], []])
                input[15] = [
