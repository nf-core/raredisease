        when {
            params {
                sarscov_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
                platform            = "illumina"
                min_trimmed_length  = 50
                outdir              = "$outputDir"
            }
            workflow {
                """
                input[0]  = channel.empty()
                input[1]  = channel.empty()
                input[2]  = channel.empty()
                input[3]  = channel.empty()
                input[4]  = GENOME_MEME.out.index.collect()
                input[5]  = channel.of([id:'genome'], file(params.sarscov_testdata_base_path + 'genomics/sarscov2/genome/genome.dict', checkIfExists: true)).collect()
                input[6]  = channel.of([id:'genome'], file(params.sarscov_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)).collect()
                input[7]  = channel.of([id:'genome'], file(params.sarscov_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)).collect()
                def read1 = file(params.sarscov_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                def read2 = file(params.sarscov_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                input[8]  = channel.fromList([
                    [[ id:'earlycasualcaiman', sample:'earlycasualcaiman', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:earlycasualcaiman\\\\tPL:illumina\\\\tSM:earlycasualcaiman'", 'lane':1, 'sex':1, 'phenotype':1, 'paternal':0, 'maternal':0, 'case_id':'justhusky'  ], // meta map
                    [ read1, read2 ]],
                    [[ id:'hugelymodelbat', sample:'hugelymodelbat', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:hugelymodelbat\\\\tPL:illumina\\\\tSM:hugelymodelbat'", 'lane':1, 'sex':1, 'phenotype':2, 'paternal':'earlycasualcaiman', 'maternal':'slowlycivilbuck', 'case_id':'justhusky'  ], // meta map
                    [
                        file(params.sarscov_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_1.fastq.gz', checkIfExists: true),
                        file(params.sarscov_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_2.fastq.gz', checkIfExists: true)
                    ]],
                    [[ id:'slowlycivilbuck', sample:'slowlycivilbuck', single_end:false, num_lanes:1, read_group: "'@RG\\\\tID:slowlycivilbuck\\\\tPL:illumina\\\\tSM:slowlycivilbuck'",  'lane':1, 'sex':2, 'phenotype':1, 'paternal':0, 'maternal':0, 'case_id':'justhusky'  ], // meta map
                    [ read1, read2 ]]
                ])
                input[9]  = true
                input[10] = "bwameme"
                input[11] = "markduplicates"
                input[12] = false
                input[13] = false
                input[14] = "illumina"
                input[15] = true
                input[16] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                {  assert snapshot(
                        workflow.out.genome_marked_cram
                            .collect { meta, cramfile -> [ meta, cram(cramfile, params.sarscov_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta').getReadsMD5() ] },
                        workflow.out.genome_marked_crai
                            .collect { meta, craifile -> [meta, file(craifile).name] },
                        workflow.out.genome_marked_bam_bai
                            .collect { meta, bamfile, index -> [ meta, bam(bamfile).getReadsMD5(), file(index).name ] }
                    ).match()
                }

            )
        }
    }
}
