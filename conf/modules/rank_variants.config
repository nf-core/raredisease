/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional clause
----------------------------------------------------------------------------------------
*/

//
// Score and rank variants
//

process {

    withName: '.*:FILTER_ANNOTATE_RANK_SV:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_sv_genmod_annotate_${meta.set}" }
        ext.args = { [
            '--annotate_regions',
            params.genome.equals('GRCh37') ? '--genome-build 37' : '--genome-build 38',
            '--temp_dir ./'
            ].join(' ') }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SV:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_sv_genmod_models_${meta.set}" }
        ext.args = "--whole_gene --temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SV:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_sv_genmod_score_${meta.set}" }
        ext.args = "--rank_results"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SV:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_sv_genmod_compound_${meta.set}" }
        ext.args = "--temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SV:RANK_VARIANTS:BCFTOOLS_SORT' {
        ext.args = "--output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}_sv_ranked_${meta.set}" }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_snv_genmod_annotate_${meta.set}" }
        ext.args = { [
            '--annotate_regions',
            params.genome.equals('GRCh37') ? '--genome-build 37' : '--genome-build 38',
            '--temp_dir ./'
            ].join(' ') }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_snv_genmod_models_${meta.set}" }
        ext.args = "--whole_gene --temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_snv_genmod_score_${meta.set}" }
        ext.args = "--rank_results"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_snv_genmod_compound_${meta.set}" }
        ext.args = "--temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:RANK_VARIANTS:TABIX_BGZIPTABIX' {
        ext.args2 = '-p vcf'
        ext.prefix = { "${meta.id}_snv_ranked_${meta.set}" }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_MT:RANK_VARIANTS:GENMOD_ANNOTATE' {
        ext.prefix = { "${meta.id}_mt_genmod_annotate_${meta.set}" }
        ext.args = { [
            '--annotate_regions',
            params.genome.equals('GRCh37') ? '--genome-build 37' : '--genome-build 38',
            '--temp_dir ./'
            ].join(' ') }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_MT:RANK_VARIANTS:GENMOD_MODELS' {
        ext.prefix = { "${meta.id}_mt_genmod_models_${meta.set}" }
        ext.args = "--whole_gene --temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_MT:RANK_VARIANTS:GENMOD_SCORE' {
        ext.prefix = { "${meta.id}_mt_genmod_score_${meta.set}" }
        ext.args = "--rank_results"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_MT:RANK_VARIANTS:GENMOD_COMPOUND' {
        ext.prefix = { "${meta.id}_mt_genmod_compound_${meta.set}" }
        ext.args = "--temp_dir ./"
    }

    withName: '.*:FILTER_ANNOTATE_RANK_MT:RANK_VARIANTS:TABIX_BGZIPTABIX' {
        ext.args2 = '-p vcf'
        ext.prefix = { "${meta.id}_mt_ranked_${meta.set}" }
    }

}
