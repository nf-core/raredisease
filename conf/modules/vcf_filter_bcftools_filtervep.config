/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional clause
----------------------------------------------------------------------------------------
*/

//
// Filter out clinical and research variants
//

// SNVs

process {
    withName: '.*:FILTER_ANNOTATE_RANK_SNV:GENERATE_CLINICAL_SET:FILTERVEP' {
        ext.prefix = { "${meta.id}_snv_${meta.set}" }
        ext.args   = { "--filter \"HGNC_ID in ${feature_file}\"" }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SNV:GENERATE_CLINICAL_SET:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}_snv_${meta.set}" }
    }
}

// SVs

process {
    withName: '.*:FILTER_ANNOTATE_RANK_SV:GENERATE_CLINICAL_SET:FILTERVEP' {
        ext.prefix = { "${meta.id}_sv_${meta.set}" }
        ext.args   = { "--filter \"HGNC_ID in ${feature_file}\"" }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_SV:GENERATE_CLINICAL_SET:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}_sv_${meta.set}" }
    }
}

// MT variants

process {
    withName: '.*:FILTER_ANNOTATE_RANK_MT:GENERATE_CLINICAL_SET:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_mt_${meta.set}" }
        ext.args   = { "-Oz -i 'AF>0.05' --write-index=tbi" }
    }
}

// ME variants
process {
    withName: '.*:FILTER_ANNOTATE_RANK_ME:GENERATE_CLINICAL_SET:FILTERVEP' {
        ext.prefix = { "${meta.id}_me_${meta.set}" }
        ext.args   = { "--filter \"HGNC_ID in ${feature_file}\"" }
    }

    withName: '.*:FILTER_ANNOTATE_RANK_ME:GENERATE_CLINICAL_SET:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}_me_${meta.set}" }
    }
}
