/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
        ext.when            = Conditional clause
----------------------------------------------------------------------------------------
*/

//
// Spring decompress options
//

process {
    withName: '.*RAREDISEASE:SPRING_DECOMPRESS_.*' {
        ext.prefix = { "${spring.simpleName}" }
    }
}

//
// Read QC options
//

process {

    withName: '.*RAREDISEASE:FASTQC' {
        ext.args = '--quiet --dir ./'
    }
}

//
// Smncopynumbercaller options
//

process {
    withName: '.*SMNCOPYNUMBERCALLER' {
        ext.args = {
        (params.genome == 'GRCh37') ? '--genome 37' : '--genome 38'
        }
        ext.prefix = { "${meta.id}_smncopynumbercaller" }
    }
}

//
// Stranger options
//

process {
    withName: '.*STRANGER' {
        ext.prefix = { "${meta.id}_repeat_expansion_stranger" }
    }
}

//
// Peddy options
//

process {
    withName: 'PEDDY' {
        // With recent changes to peddy module in nf-core
        // --plot: the module no longer runs --plot unconditionally (a
        // caller opts in via ext.args). We want plotting on for real runs,
        // same as the pipeline's prior default behavior, but off for
        // params.vep_gtf runs (e.g. a minimal/sliced-reference test
        // dataset) -- at very low variant counts peddy's plotting step can
        // crash in matplotlib ("need at least one array to concatenate")
        // while the actual relatedness/sex-check analysis (the .csv
        // outputs) completes fine.
        //
        // peddy_sites: peddy's bundled --sites hg19/hg38 files are ~23k
        // real, absolute-GRCh38-coordinate common-SNP positions. Against a
        // coordinate-remapped/sliced reference none of them overlap the
        // VCF, so cyvcf2's het_check ends up with zero sites and crashes
        // with IndexError instead of just producing an empty result. When
        // params.peddy_sites is set, it's staged and passed via the
        // module's own `sites` input channel (see the PEDDY call site in
        // workflows/raredisease.nf) instead of ext.args, since peddy/cyvcf2
        // can't fetch a URL themselves -- only the hg19/hg38 keyword case
        // (no file to stage) belongs here.
        ext.args = { (params.peddy_sites ? "" : (params.genome.equals("GRCh38") ? "--sites hg38 " : "")) + (params.vep_gtf ? "" : "--plot") }
    }
}

//
// Multiqc options
//

process {
    withName: '.*RAREDISEASE:MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }
}

//
// Concatenate nuclear and MT SNV calls options
//

process {
    withName: '.*RAREDISEASE:CONCAT_NUCLEAR_AND_MT_SNVS' {
        ext.args   = { "--write-index=tbi  --output-type z" }
        ext.prefix = { "${meta.id}_mt_and_nuclear_snvs" }
    }
}

//
// Merge nuclear and mitochondrial SV calls options
//

process {
    withName: '.*RAREDISEASE:MERGE_NUCLEAR_AND_MT_SVS' {
        ext.prefix = { "${meta.id}_sv" }
        ext.args   = '--pass_only --same_order'
    }
}
