nextflow_workflow {

    name "Test Somalier without sample groups"
    script "../subworkflows/nf-core/vcf_extract_relate_somalier/main.nf"
    workflow "VCF_EXTRACT_RELATE_SOMALIER"

    tag "subworkflows"
    tag "somalier"
    tag "somalier/extract"
    tag "somalier/relate"

    test("Somalier relate runs without a sample-groups file") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [id: 'amusingmarmoset'],
                    file(params.precalled + '/trio/amusingmarmoset_precalled_snv.vcf.gz', checkIfExists: true),
                    file(params.precalled + '/trio/amusingmarmoset_precalled_snv.vcf.gz.tbi', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([[id: 'genome'], file(params.reference_sliced + '/minimal_reference.fasta', checkIfExists: true)])
                input[2] = channel.value([[id: 'genome'], file(params.reference_sliced + '/minimal_reference.fasta.fai', checkIfExists: true)])
                input[3] = channel.value([[id: 'sites'], []])
                input[4] = channel.of([[id: 'amusingmarmoset'], []])
                input[5] = channel.value([])
                input[6] = ''
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.extract.size() == 1
            assert workflow.out.html.size() == 1
            assert workflow.out.pairs_tsv.size() == 1
            assert workflow.out.samples_tsv.size() == 1
            assert workflow.out.publish.size() == 3
        }
    }
}