/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/raredisease/'
    sarscov_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

    // Convenience prefixes for the minimal test dataset (used by the subworkflow nf-tests)
    alignment            = params.pipelines_testdata_base_path + 'alignment'
    reference_sliced     = params.pipelines_testdata_base_path + 'reference_sliced'
    subworkflow_fixtures = params.pipelines_testdata_base_path + 'subworkflow_fixtures'
    resources_remapped   = params.pipelines_testdata_base_path + 'resources_remapped'
    precalled            = params.pipelines_testdata_base_path + 'precalled'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// NOTE This is how pipeline users will use Sentieon in real world use
env.SENTIEON_LICENSE = env('SENTIEON_LICSRVR_IP')

// NOTE This should only happen in GitHub actions or nf-core MegaTests
env.SENTIEON_AUTH_MECH = env('SENTIEON_AUTH_MECH')
env.SENTIEON_AUTH_DATA = secrets.SENTIEON_AUTH_DATA
