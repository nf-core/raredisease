// nf-test config for the heavyweight ANNOTATE_CADD scoring test only.
//
// Identical to ../nf-test.config except that it does NOT ignore
// subworkflows/local/annotate_cadd/tests/cadd_scoring.nf.test, so that test
// (which pulls the ~20 GB CADD container) can be run on its own from
// .github/workflows/nf-test-cadd.yml (triggered only by PRs touching the
// annotate_cadd subworkflow or a module it uses):
//
//   nf-test test -c tests/nf-test-cadd.config \
//       subworkflows/local/annotate_cadd/tests/cadd_scoring.nf.test --profile=+docker

config {
    testsDir   = "."
    workDir    = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/nextflow.config"
    libDir     = "tests/lib"

    ignore = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
    ]

    profile = "test"

    plugins {
        load "nft-utils@0.0.3"
        load "nft-bam@0.6.1"
        load "nft-vcf@1.0.7"
    }
}
